# Copy this file to .env and fill in your own values, then:
#   set -a && source .env && set +a
# before running the pipeline. Never commit a real .env file.
#
# Non-secret tunables below (TTS engine choice, image cadence, master
# prompt, etc.) can ALSO be changed live via the control center
# (python -m pipeline.control_center) without touching this file or
# restarting anything -- pipeline_config.json overrides these defaults.

# --- Scriptwriting ---
# "groq" (default -- no $10-credit gate, far more generous free tier) or
# "openrouter" (50 free requests/day account-wide unless $10 lifetime
# credit purchased -- verified 2026-09-18)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
# Exact free model slug from https://openrouter.ai/models (filter: free).
# Slugs for free/stealth models rotate -- check the site rather than guessing.
OPENROUTER_MODEL=

# --- Voiceover ---
# "piper" (default, free/local), "elevenlabs", or "fishaudio"
TTS_ENGINE=piper
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FISHAUDIO_API_KEY=
FISHAUDIO_REFERENCE_ID=

# --- Images ---
# "placeholder" (default, free/local), "pollinations" (free, no signup
# needed to generate -- but the "nologo" watermark removal specifically
# needs a free account key from https://enter.pollinations.ai), or "imagen"
# (Gemini API, real generated visuals -- get a key at https://aistudio.google.com)
IMAGE_ENGINE=placeholder
POLLINATIONS_API_KEY=
GEMINI_API_KEY=
IMAGE_CADENCE_SECONDS=2.75
IMAGE_MASTER_PROMPT=

# --- Background music ---
MUSIC_ENABLED=true
MUSIC_VOLUME=0.12

# --- Video ---
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
FPS=30
